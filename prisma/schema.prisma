generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AgentStatus {
  active
  inactive
}

enum ExecutionStatus {
  running
  success
  error
}

enum ToolCallStatus {
  success
  error
}

enum MessageRole {
  user
  assistant
}

enum ConnectionStatus {
  connected
  stale
  disconnected
}

// NEW (v2.1, §16) — represents one connected external backend (an
// @agentkit/node process). Issued a projectKey at creation, same
// hash-once pattern as ApiKey.hashedKey.
model Project {
  id          String           @id @default(cuid())
  name        String
  projectKey  String           @unique
  framework   String?
  nodeVersion String?
  sdkVersion  String?
  status      ConnectionStatus @default(disconnected)
  lastSeenAt  DateTime?

  tools Tool[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

// NEW (v2.1, §16) — replaces the code-only tool registry with a real row
// per SDK-registered tool. Rows are only ever written by the WS gateway's
// register_tool message (§15) — there is no manual-create REST route,
// intentionally (§10.3).
model Tool {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name          String
  description   String
  inputSchema   Json
  outputExample Json?
  enabled       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@map("tools")
}

// Scoped intentionally to just what agent.service.ts needs today.
// Tool models get their own schema additions (and their own migrations)
// when we build that feature.
model Agent {
  id           String      @id @default(cuid())
  name         String
  description  String      @default("")
  instructions String
  model        String      @default("gpt-4.1-mini")
  temperature  Float       @default(0.3)
  status       AgentStatus @default(active)

  // Tools are registered in code (src/tools), not user-created rows, so
  // we store the agent's enabled tools as JSON rather than a relational
  // join table — avoids having to keep a Tool table in sync with the
  // code-based tool registry for something that isn't user-editable yet.
  tools Json @default("[]")

  executions    Execution[]
  apiKeys       ApiKey[]
  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agents")
}

model Conversation {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  messages   Message[]
  executions Execution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@map("messages")
}

model Execution {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // Optional — set when this run happened as part of a multi-turn
  // conversation (chatWithAgent accepts an optional conversationId).
  // Nullable and onDelete: SetNull so deleting a conversation doesn't
  // wipe out its execution/trace history.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  status    ExecutionStatus @default(running)
  input     String
  output    String?
  error     String?
  latencyMs Int             @default(0)
  tokens    Int             @default(0)

  toolCalls ToolCall[]

  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([conversationId])
  @@map("executions")
}

model ToolCall {
  id          String    @id @default(cuid())
  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  name       String
  arguments  Json
  result     Json?
  durationMs Int
  status     ToolCallStatus @default(success)
  error      String?

  createdAt DateTime @default(now())

  @@index([executionId])
  @@map("tool_calls")
}

model ApiKey {
  id      String @id @default(cuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  label      String
  // SHA-256 hash of the raw key — the raw value is only ever shown once,
  // at creation time, and is never persisted (PRD §27).
  hashedKey  String    @unique
  keyPreview String
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([agentId])
  @@map("api_keys")
}
